# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (read by config/settings.py via dj_database_url)
# ---------------------------------------------------------------------------
# Supabase / Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/billdash

# ---------------------------------------------------------------------------
# Alternative: individual Postgres settings
# Only needed if you switch config/settings.py back to the commented-out
# DATABASES block that uses these variables instead of DATABASE_URL.
# ---------------------------------------------------------------------------
# POSTGRES_DB=billdash
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Django core settings
# NOTE: config/settings.py currently hard-codes SECRET_KEY, DEBUG and
# ALLOWED_HOSTS. These entries are here so they can be moved to the
# environment; they have no effect until settings.py reads them.
# ---------------------------------------------------------------------------
# SECRET_KEY=django-insecure-change-me
# DEBUG=False
# ALLOWED_HOSTS=*
